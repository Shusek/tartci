<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the schedule backstop.

  Runs scripts/schedule_backstop.py every 300 s. GitHub delays and drops
  `schedule` events under load; on Generous-Corp/pulp every hourly-or-faster
  cron fires about once every five hours. This agent calls workflow_dispatch on
  each workflow listed in the repository's .github/schedule-backstop.json once
  the newest run of that workflow on main (from any event) is older than its
  cadence and none is queued or running. See the script docstring.

  WHY ON THE MAC, NOT A GITHUB WORKFLOW: a workflow cannot fix GitHub's own
  scheduler, and a long-lived "ticker" job would hold a hosted-runner slot the
  safety nets themselves compete for. This agent only makes API calls; the
  dispatched workflows still run on GitHub-hosted runners.

  FAIL OPEN: the crons stay in place. With this agent off, erroring, or its host
  down, the repository behaves exactly as it does without it.

  SAFETY: install on exactly ONE always-on host, dry-run first.
    1. DRY-RUN (TARTCI_BACKSTOP_APPLY=0) logs what it would dispatch, paced as
       apply would pace it. Watch the log for a few hours.
    2. LIVE (TARTCI_BACKSTOP_APPLY=1 and TARTCI_BACKSTOP_AUTHORITY=1) dispatches.
  Turn it off with `launchctl bootout gui/$(id -u)/com.danielraffel.pulp.schedule-backstop`.

  Install shape:

    mkdir -p "$HOME/Library/Logs"
    sed -e "s|\$HOME|$HOME|g" \
      launchd/com.danielraffel.pulp.schedule-backstop.plist.template \
      > "$HOME/Library/LaunchAgents/com.danielraffel.pulp.schedule-backstop.plist"
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/com.danielraffel.pulp.schedule-backstop.plist"
    launchctl kickstart -k "gui/$(id -u)/com.danielraffel.pulp.schedule-backstop"
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.pulp.schedule-backstop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>$HOME/.local/share/tartci/scripts/schedule_backstop.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/pulp-schedule-backstop.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/pulp-schedule-backstop.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TARTCI_BACKSTOP_REPO</key>
        <string>Generous-Corp/pulp</string>
        <key>TARTCI_BACKSTOP_GH_CLI</key>
        <string>ghapp</string>
        <key>TARTCI_BACKSTOP_APPLY</key>
        <string>0</string>
        <key>TARTCI_BACKSTOP_AUTHORITY</key>
        <string>0</string>
    </dict>
</dict>
</plist>
